<!--
  Cisco Email Security Reporter – Outlook add-in manifest.
  Strings: en-US default with da-DK and sv-SE overrides (Outlook picks the user's language).
  Replace addin.example.com with the HTTPS host where src/ is published:
    scripts/set-host.sh addin.contoso.com
-->
<OfficeApp
  xmlns="http://schemas.microsoft.com/office/appforoffice/1.1"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xmlns:bt="http://schemas.microsoft.com/office/officeappbasictypes/1.0"
  xmlns:mailappor="http://schemas.microsoft.com/office/mailappversionoverrides/1.0"
  xsi:type="MailApp">

  <Id>8cec0077-122f-4b5b-a7ec-b779f92668c7</Id>
  <Version>1.1.0.0</Version>
  <ProviderName>IT department</ProviderName>
  <DefaultLocale>en-US</DefaultLocale>
  <DisplayName DefaultValue="Cisco Email Security Reporter"/>
  <Description DefaultValue="Report spam, phishing, virus and marketing mail to Cisco, or tell Cisco when a legitimate mail was wrongly stopped.">
    <Override Locale="da-DK" Value="Rapportér spam, phishing, virus og marketing til Cisco – eller fortæl Cisco, at en mail fejlagtigt blev stoppet."/>
    <Override Locale="sv-SE" Value="Rapportera skräppost, nätfiske, virus och marknadsföring till Cisco – eller berätta för Cisco att ett legitimt mejl felaktigt stoppades."/>
  </Description>
  <IconUrl DefaultValue="https://magnusfrodell.github.io/cisco-email-security-outlook-addin/assets/icon-64.png"/>
  <HighResolutionIconUrl DefaultValue="https://magnusfrodell.github.io/cisco-email-security-outlook-addin/assets/icon-128.png"/>
  <SupportUrl DefaultValue="https://magnusfrodell.github.io/cisco-email-security-outlook-addin/support.html"/>

  <AppDomains>
    <AppDomain>https://magnusfrodell.github.io/cisco-email-security-outlook-addin</AppDomain>
    <AppDomain>https://login.microsoftonline.com</AppDomain>
  </AppDomains>

  <Hosts>
    <Host Name="Mailbox"/>
  </Hosts>

  <Requirements>
    <Sets>
      <Set Name="Mailbox" MinVersion="1.6"/>
    </Sets>
  </Requirements>

  <FormSettings>
    <Form xsi:type="ItemRead">
      <DesktopSettings>
        <SourceLocation DefaultValue="https://magnusfrodell.github.io/cisco-email-security-outlook-addin/taskpane.html"/>
        <RequestedHeight>250</RequestedHeight>
      </DesktopSettings>
    </Form>
  </FormSettings>

  <Permissions>ReadWriteItem</Permissions>

  <Rule xsi:type="RuleCollection" Mode="Or">
    <Rule xsi:type="ItemIs" ItemType="Message" FormType="Read"/>
  </Rule>

  <DisableEntityHighlighting>false</DisableEntityHighlighting>

  <VersionOverrides xmlns="http://schemas.microsoft.com/office/mailappversionoverrides" xsi:type="VersionOverridesV1_0">
    <VersionOverrides xmlns="http://schemas.microsoft.com/office/mailappversionoverrides/1.1" xsi:type="VersionOverridesV1_1">

      <Requirements>
        <bt:Sets DefaultMinVersion="1.6">
          <bt:Set Name="Mailbox"/>
        </bt:Sets>
      </Requirements>

      <Hosts>
        <Host xsi:type="MailHost">
          <DesktopFormFactor>
            <FunctionFile resid="Taskpane.Url"/>
            <ExtensionPoint xsi:type="MessageReadCommandSurface">
              <OfficeTab id="TabDefault">
                <Group id="msgReadGroup">
                  <Label resid="GroupLabel"/>
                  <Control xsi:type="Button" id="msgReadOpenPaneButton">
                    <Label resid="TaskpaneButton.Label"/>
                    <Supertip>
                      <Title resid="TaskpaneButton.Label"/>
                      <Description resid="TaskpaneButton.Tooltip"/>
                    </Supertip>
                    <Icon>
                      <bt:Image size="16" resid="Icon.16x16"/>
                      <bt:Image size="32" resid="Icon.32x32"/>
                      <bt:Image size="80" resid="Icon.80x80"/>
                    </Icon>
                    <Action xsi:type="ShowTaskpane">
                      <SourceLocation resid="Taskpane.Url"/>
                      <SupportsPinning>true</SupportsPinning>
                    </Action>
                  </Control>
                </Group>
              </OfficeTab>
            </ExtensionPoint>
          </DesktopFormFactor>
        </Host>
      </Hosts>

      <Resources>
        <bt:Images>
          <bt:Image id="Icon.16x16" DefaultValue="https://magnusfrodell.github.io/cisco-email-security-outlook-addin/assets/icon-16.png"/>
          <bt:Image id="Icon.32x32" DefaultValue="https://magnusfrodell.github.io/cisco-email-security-outlook-addin/assets/icon-32.png"/>
          <bt:Image id="Icon.80x80" DefaultValue="https://magnusfrodell.github.io/cisco-email-security-outlook-addin/assets/icon-80.png"/>
        </bt:Images>
        <bt:Urls>
          <bt:Url id="Taskpane.Url" DefaultValue="https://magnusfrodell.github.io/cisco-email-security-outlook-addin/taskpane.html"/>
        </bt:Urls>
        <bt:ShortStrings>
          <bt:String id="GroupLabel" DefaultValue="Email security">
            <bt:Override Locale="da-DK" Value="Mailsikkerhed"/>
            <bt:Override Locale="sv-SE" Value="E-postsäkerhet"/>
          </bt:String>
          <bt:String id="TaskpaneButton.Label" DefaultValue="Report to Cisco">
            <bt:Override Locale="da-DK" Value="Rapportér til Cisco"/>
            <bt:Override Locale="sv-SE" Value="Rapportera till Cisco"/>
          </bt:String>
        </bt:ShortStrings>
        <bt:LongStrings>
          <bt:String id="TaskpaneButton.Tooltip" DefaultValue="Report spam, phishing, virus or marketing mail to Cisco, or tell Cisco when a legitimate mail was wrongly stopped.">
            <bt:Override Locale="da-DK" Value="Rapportér spam, phishing, virus eller marketing til Cisco – eller fortæl Cisco, at en mail fejlagtigt blev stoppet."/>
            <bt:Override Locale="sv-SE" Value="Rapportera skräppost, nätfiske, virus eller marknadsföring till Cisco – eller berätta för Cisco att ett legitimt mejl felaktigt stoppades."/>
          </bt:String>
        </bt:LongStrings>
      </Resources>

    </VersionOverrides>
  </VersionOverrides>
</OfficeApp>
